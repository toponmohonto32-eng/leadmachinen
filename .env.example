# Database Configuration
# For production, use PostgreSQL or MySQL
# Example: DATABASE_URL="postgresql://user:password@host:port/database"
DATABASE_URL="file:./dev.db"

# Lead Generation - FREE Custom Scraper (Primary)
# The system uses a FREE Puppeteer-based Google Maps scraper
# No API key required! The scraper is pre-installed and ready to use.
# Just search for businesses and it will scrape real data from Google Maps.

# Optional: Outscraper API (Fallback - Paid)
# Only needed if Puppeteer scraper fails. Not required for normal operation.
# Get your API key from: https://outscraper.com/
# OUTSCRAPER_API_KEY="your-outscraper-api-key-here"

# AI Provider API Keys (Optional)
# Required for AI scoring, enrichment, and validation features
# Get your API keys from the respective providers

# Z AI (Primary Provider - for AI features)
AI_ZAI_API_KEY="your-zai-api-key-here"

# Together AI (Backup Provider)
AI_TOGETHER_API_KEY="your-together-api-key-here"

# Hugging Face (Backup Provider)
AI_HUGGINGFACE_API_KEY="your-huggingface-api-key-here"

# Ollama (Local Provider - if applicable)
AI_OLLAMA_API_KEY="your-ollama-api-key-here"

# LocalAI (Local Provider - if applicable)
AI_LOCALAI_API_KEY="your-localai-api-key-here"

# AI Configuration
AI_DEFAULT_PROVIDER="zai"

# NextAuth Configuration (if using authentication)
NEXTAUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# App Configuration
NODE_ENV="production"
